@model WebApplication13.Models.Product

@{
    ViewBag.Title = "Product Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 32px; color: #222; }
        .details { max-width: 600px; border: 1px solid #bbb; padding: 20px; border-radius: 6px; }
        .details p { margin: 12px 0; }
        a { color: #075fc7; }
    </style>
</head>
<body>
    <h2>Product Details</h2>

    @if (Model != null)
    {
        <div class="details">
            <p><strong>Product Id:</strong> @Model.ProductId</p>
            <p><strong>Product Name:</strong> @Model.ProductName</p>
            <p><strong>Description:</strong> @Model.Description</p>
            <p><strong>Price:</strong> ₹@Model.Price.ToString("N2")</p>
            <p><strong>Category:</strong> @Model.Category</p>
        </div>
    }
    else
    {
        <p>Product not found.</p>
    }

    <p>@Html.ActionLink("Back to Product Catalog", "Index", "Product")</p>
</body>
</html>
